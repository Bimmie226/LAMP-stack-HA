events {}

stream {
    upstream maxscale_instances_RW {
	least_conn;	

        server maxscale01:4001 max_fails=3 fail_timeout=10s;
        server maxscale02:4002 max_fails=3 fail_timeout=10s;
        server maxscale03:4003 max_fails=3 fail_timeout=10s;
    }

    upstream maxscale_instances_RO {
	least_conn;	

        server maxscale01:4004 max_fails=3 fail_timeout=10s;
        server maxscale02:4005 max_fails=3 fail_timeout=10s;
        server maxscale03:4006 max_fails=3 fail_timeout=10s;
    }

    server {
        listen 4000; 
	proxy_connect_timeout 5s;
	proxy_timeout 1h; 
	proxy_pass maxscale_instances_RW;    
    }  

    server { 
	listen 4001; 
	proxy_connect_timeout 5s;
	proxy_timeout 1h; 
	proxy_pass maxscale_instances_RO; 
    } 
}
