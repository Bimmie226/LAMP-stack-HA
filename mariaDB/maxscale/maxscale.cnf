[maxscale]
threads                 = auto   
log_augmentation        = 1
ms_timestamp            = 1
syslog                  = 0
maxlog                  = 1
admin_host              = 0.0.0.0
admin_port              = 8989

# Monitor

[Galera-monitor]
type=monitor 
module=galeramon
servers=db01,db02,db03
user=maxscale
password=123456
monitor_interval=2s

# Servers

[db01]
type=server
address=db01
port=3306
protocol=MariaDBBackend
priority=1

[db02]
type=server
address=db02
port=3306
protocol=MariaDBBackend
priority=2

[db03]
type=server
address=db03
port=3306
protocol=MariaDBBackend
priority=3

# Services

[RW-service]
type=service
router=readwritesplit
servers=db01,db02,db03
user=maxscale
password=123456

[RO-service]
type=service
router=readconnroute
servers=db02,db03
user=maxscale
password=123456

# Listeners
[RW-Listener]
type=listener
service=RW-service
protocol=MariaDBClient
port=4000

[RO-Listener]
type=listener
service=RO-service
protocol=MariaDBClient
port=4001
